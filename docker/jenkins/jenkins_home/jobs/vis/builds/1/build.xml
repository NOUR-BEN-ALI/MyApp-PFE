        GIT_BRANCH = &apos;tempo&apos;
        REPO_DIR = &apos;MyApp-PFE&apos;
        registry = &quot;docker.io&quot;
        registryCredential = &apos;docker_visionaryops&apos;
    }

    stages {
        stage(&apos;Clone my Branch from Git&apos;) {
            steps {
                script {
                    if (fileExists(REPO_DIR)) {
                        dir(REPO_DIR) {
                            sh &apos;git pull&apos;
                        }
                    } else {
                        sh &quot;git clone --branch ${env.GIT_BRANCH} https://NOUR-BEN-ALI:${env.GIT_CREDENTIALS}@${env.GIT_REPO_URL} ${REPO_DIR}&quot;
                    }
                }
            }
        }

        stage(&apos;Clean and compile with Maven&apos;) {
            steps {
                dir(REPO_DIR) {
                    sh &apos;mvn clean install -DskipTests&apos;
                }
            }
        }

        stage(&apos;Build Docker Images&apos;) {
            steps {
                script {
                    def images = [
                        &apos;nourbenali/visionaryops-microservice11&apos;,
                        &apos;nourbenali/visionaryops-microservice22&apos;,
                        &apos;nourbenali/visionaryops-microservice33&apos;
                    ]
                    
                    images.each { image -&gt;
                        dir(REPO_DIR) {
                            def imageTag = &quot;${image}:${env.BUILD_NUMBER}&quot;
                            docker.build(imageTag, &quot;-f ${image}/Dockerfile .&quot;)
                            env.&quot;${image.replace(&apos;/&apos;, &apos;_&apos;)}_IMAGE&quot; = imageTag
                        }
                    }
                }
            }
        }

        stage(&apos;Push Docker Images&apos;) {
            steps {
                script {
                    def images = [
                        &apos;nourbenali/visionaryops-microservice11&apos;,
                        &apos;nourbenali/visionaryops-microservice22&apos;,
                        &apos;nourbenali/visionaryops-microservice33&apos;
                    ]
                    
                    images.each { image -&gt;
                        def imageTag = env.&quot;${image.replace(&apos;/&apos;, &apos;_&apos;)}_IMAGE&quot;
                        docker.withRegistry(&apos;&apos;, registryCredential) {
                            docker.image(imageTag).push()
                        }
                    }
                }
            }
        }

        stage(&apos;Docker Compose Up&apos;) {
            steps {
                dir(REPO_DIR) {
                    sh &quot;docker-compose up -d&quot;
                }
            }
        }
    }
}
</script>
