    <script>pipeline {
    agent any
  
    environment {
        // Define environment variables to store credentials and repo info
        GIT_CREDENTIALS = credentials(&apos;git_visionaryops&apos;)
        GIT_REPO_URL = &apos;github.com/NOUR-BEN-ALI/MyApp-PFE.git&apos; 
        GIT_BRANCH = &apos;tempo&apos;
        REPO_DIR = &apos;MyApp-PFE&apos;
        registry = &quot;docker.io/your_dockerhub_username&quot;
        registryCredential = &apos;docker_visionaryops1&apos; 
    }

    stages {
        stage(&apos;Clone my Branch from Git&apos;) {
            steps {
                script {
                    if (fileExists(REPO_DIR)) {
                        dir(REPO_DIR) {
                            sh &apos;git pull&apos;
                        }
                    } else {
                        sh &quot;git clone --branch ${env.GIT_BRANCH} https://NOUR-BEN-ALI:${env.GIT_CREDENTIALS}@${env.GIT_REPO_URL} ${REPO_DIR}&quot;
                    }
                }
            }
        }
        stage(&apos;Clean and compile with Maven ms1&apos;) {
            steps {
                dir(REPO_DIR +&apos;/Microservice1&apos;) {
                    sh &apos;mvn clean install -DskipTests&apos;
                }
            }
        }
        stage(&apos;Clean and compile with Maven ms2&apos;) {
            steps {
                dir(REPO_DIR +&apos;/Microservice2&apos;) {
                    sh &apos;mvn clean install -DskipTests&apos;
                }
            }
        }
        stage(&apos;Clean and compile with Maven ms3&apos;) {
            steps {
                dir(REPO_DIR +&apos;/Microservice3&apos;) {
                    sh &apos;mvn clean install -DskipTests&apos;
                }
            }
        }
        stage(&apos;Building image ms1&apos;) { 
            steps { 
                dir(REPO_DIR +&apos;/Microservice1&apos;) {
                    script { 
                        dockerImage1 = docker.build(&quot;${registry}/microservice1:$BUILD_NUMBER&quot;)
                    }
                }
            } 
        }
        stage(&apos;Building image ms2&apos;) { 
            steps { 
                dir(REPO_DIR +&apos;/Microservice2&apos;) {
                    script { 
                        dockerImage2 = docker.build(&quot;${registry}/microservice2:$BUILD_NUMBER&quot;)
                    }
                }
            } 
        }
        stage(&apos;Building image ms3&apos;) { 
            steps { 
                dir(REPO_DIR +&apos;/Microservice3&apos;) {
                    script { 
                        dockerImage3 = docker.build(&quot;${registry}/microservice3:$BUILD_NUMBER&quot;)
                    }
                }
            } 
        }
        stage(&apos;Push Docker Images to DockerHub&apos;) {
            steps {
                script {
                    docker.withRegistry(&apos;&apos;, registryCredential) {
                        dockerImage1.push()
                        dockerImage2.push()
                        dockerImage3.push()
                    }
                }
            }
        }
        stage(&apos;Build with Docker Compose&apos;) {
            steps {
                script {
